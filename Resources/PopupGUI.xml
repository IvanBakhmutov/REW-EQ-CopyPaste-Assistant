<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
        WindowStyle='none'
        AllowsTransparency='True'
        Background='Transparent'
        Width='272' Height='170'
        Topmost='True'
        ShowInTaskbar='False'
        Title='REW EQ CopyPaste Assistant'>
    <Border Name='WindowBorder'

            BorderBrush='#3383D487'
            BorderThickness='1'>

        <Grid Name='MainGrid' Background="White">
            <Button Name='ExitBTN'
                    Width='80'
                    Height='25'
                    HorizontalAlignment='Right'
                    VerticalAlignment='Bottom'
                    Content='Exit' Margin="0,0,10,10"/>
            <Label Name="Title" Content="REW EQ CopyPaste Assistant" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBlock Name="MessageTextBlock" HorizontalAlignment="Left" Margin="10,41,0,0" TextWrapping="Wrap" Text="Message text" VerticalAlignment="Top" Height="85" Width="247"/>
            <Image Margin="10,126,228,10"/>
        </Grid>
    </Border>
</Window>