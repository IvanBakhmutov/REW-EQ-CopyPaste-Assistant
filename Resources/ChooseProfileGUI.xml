<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REW EQ CopyPaste Assistant - Choose DSP profile" Height="450" Width="800" ResizeMode="NoResize">
    <Grid>
        <GroupBox Header="Profile list" Margin="0,0,526,35">
            <ListBox x:Name="ProfileList" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <GroupBox Header="Profile settings" Margin="279,0,0,35">
            <TextBox x:Name="ProfileText" TextWrapping="Wrap" Text="Please select a profile" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <Button x:Name="OKBTN" Content="OK" Width="80" IsEnabled="False" IsDefault="True" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,30,280,5"/>
        <Button x:Name="NewProfileBTN" Content="*New Profile" Width="80" IsEnabled="False" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,30,190,5"/>
        <Button x:Name="EditBTN" Content="*Edit" Width="80" IsEnabled="False" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,30,100,5"/>
        <Button x:Name="CloseBTN" Content="Close" Width="80" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,30,10,5"/>
        <Button x:Name="GitHub" Content="GitHub project page" Width="156"  Height="25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,5" Foreground="#FF001BFB" BorderBrush="{x:Null}" Background="{x:Null}" BorderThickness="0,0,0,0"/>
    </Grid>
</Window>
