<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REW EQ CopyPaste Assistant - Choose DSP profile" Height="602" Width="800" MinWidth="800" MinHeight="450">
 <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="37"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="159*"/>
            <ColumnDefinition Width="238*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="DSP profile list" Margin="0,0,4,3">
            <ListBox x:Name="ProfileList" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <GroupBox Header="Profile settings" Margin="7,0,0,3" Grid.Column="1">
            <TextBox x:Name="ProfileText" TextWrapping="Wrap" Text="Please select a profile" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <Button x:Name="OKBTN" ToolTipService.InitialShowDelay="200" ToolTip="Start with selected profile" Content="OK" Width="80" IsEnabled="False" IsDefault="True" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,280,10" Grid.Column="1" Grid.Row="1"/>
        <Button x:Name="NewProfileBTN"  ToolTipService.InitialShowDelay="200" ToolTip="Create a new profile" Content="New Profile" Width="80" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,190,10" Grid.Column="1" Grid.Row="1"/>
        <Button x:Name="EditBTN"  ToolTipService.InitialShowDelay="200" ToolTip="Edit or save a copy of selected profile" Content="Edit" Width="80" IsEnabled="False" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,10" Grid.Column="1" Grid.Row="1"/>
        <Button x:Name="CloseBTN"  ToolTipService.InitialShowDelay="200" ToolTip="Close the tool" Content="Close" Width="80" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Column="1" Grid.Row="1"/>
        <Button x:Name="GitHub"  ToolTipService.InitialShowDelay="200" ToolTip="Open GitHub project page in web browser" Content="GitHub project page" Width="130"  Height="25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" Foreground="#FF001BFB" BorderBrush="{x:Null}" Background="{x:Null}" BorderThickness="0,0,0,0" Grid.Row="1"/>
        <Label x:Name="HotkeyHint" Content="HotkeyHint" HorizontalAlignment="Left" Margin="175,0,0,10" VerticalAlignment="Bottom" Height="26" Width="241" Grid.Row="1" Grid.ColumnSpan="2"/>
        <Button x:Name="Donate"  FontFamily="Segoe UI Emoji" ToolTipService.InitialShowDelay="200" Content="😀" Width="29"  Height="25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="145,0,0,10" Foreground="#FF001BFB" BorderBrush="{x:Null}" Background="{x:Null}" BorderThickness="0,0,0,0" Grid.Row="1" ToolTip="Support the project (PayPal)"/>
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0">
            <StatusBarItem  BorderThickness="0"  BorderBrush="#FFA8A8A8">
                <TextBlock Text="DSP:" FontFamily="Segoe UI Symbol" />
            </StatusBarItem>
            <StatusBarItem  BorderThickness="0"  BorderBrush="#FFA8A8A8">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="ProcessStatus" Text="⬤" Width="15" MinWidth="15" Foreground="Gray" ToolTip="DSP Software Status" />
            </StatusBarItem>
            <StatusBarItem  BorderThickness="0"  BorderBrush="#FFA8A8A8">
                <TextBlock Text="REW API:" FontFamily="Segoe UI Symbol" />
            </StatusBarItem>
            <StatusBarItem  BorderThickness="0"  BorderBrush="#FFA8A8A8">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="REWStatus" Text="⬤" Width="15" MinWidth="15" Foreground="Gray" ToolTip="REW Status" />
            </StatusBarItem>
            <Button x:Name="RunREWBTN" ToolTipService.InitialShowDelay="200" ToolTip="Start REW in API mode" Content="▶️" Width="22" Background="{x:Null}" Padding="0" BorderThickness="0" BorderBrush="{x:Null}" Foreground="orange" Visibility="Hidden" />
            <StatusBarItem BorderThickness="0"  BorderBrush="#FFA8A8A8">
                <TextBlock x:Name ="Hint" Text="Hint: Select a profile to begin" />
            </StatusBarItem>
            <StatusBarItem  BorderThickness="0" BorderBrush="#FFA8A8A8" HorizontalAlignment="Right" >
                <TextBlock Text="Version: 0.2.1" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
