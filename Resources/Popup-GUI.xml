<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStyle='none'
    AllowsTransparency='True'
    Background='Transparent'
    Width='280' Height='200'
    Topmost='True'
    ShowInTaskbar='False'
    Title='REW EQ CopyPaste Assistant'>

    <Window.Resources>
        <Color x:Key="WindowBgColor">#FF292929</Color>
        <Color x:Key="ContainerBgColor">#FF35353A</Color>
        <Color x:Key="AccentBlueColor">#FF65ABFE</Color>
        <Color x:Key="DarkAccentBlueColor">#FF367ACB</Color>
        <Color x:Key="SurfaceColor">#FF1E1E1E</Color>
        <Color x:Key="LightGrayColor">#FFCCCCCC</Color>
        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
        <SolidColorBrush x:Key="ContainerBgBrush" Color="{StaticResource ContainerBgColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentBlueColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
        <SolidColorBrush x:Key="TextMainBrush" Color="White" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAAAAA" />
        <Style x:Key="RoundedBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}"
                            Padding="10,2">
                            <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF94D3FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#444444" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name='WindowBorder'
        BorderBrush='#3383D487'
        BorderThickness='1'>
        <Grid x:Name='MainGrid' Background="White">
            <Button x:Name='ExitBTN'
                Width='80'
                Height='25'
                HorizontalAlignment='Right'
                VerticalAlignment='Bottom'
                Style="{StaticResource RoundedBlueButtonStyle}"
                Content='Exit' Margin="0,0,10,10" IsDefault="True" />
            <Label x:Name="Title" Content="REW EQ CopyPaste Assistant" HorizontalAlignment="Left"
                Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold" />
            <TextBlock x:Name="MessageTextBlock" Margin="10,41,10,40" TextWrapping="Wrap"
                Text="Message text" />
            <Image x:Name="Icon" Margin="10,156,236,10" Width="32" Height="32" />
            <Button x:Name='SelectProfileBTN'
                Width='80'
                Height='25'
                HorizontalAlignment='Right'
                VerticalAlignment='Bottom'
                Style="{StaticResource RoundedBlueButtonStyle}"
                Content='Profile' Margin="0,0,95,10" />
        </Grid>
    </Border>
</Window>