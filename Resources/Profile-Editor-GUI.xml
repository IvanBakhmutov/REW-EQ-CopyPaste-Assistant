<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:WpfApp1"
        Title="Edit profile" Height="600" Width="800" MinWidth="800" MinHeight="600" Margin="-3,0,0,0"
        FontStretch="Expanded"
    FontStyle="Normal"
    FontWeight="Normal"
    Background="#FF292929"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="WindowBgColor">#FF292929</Color>
        <Color x:Key="ContainerBgColor">#FF35353A</Color>
        <Color x:Key="AccentBlueColor">#FF65ABFE</Color>
        <Color x:Key="DarkAccentBlueColor">#FF367ACB</Color>
        <Color x:Key="SurfaceColor">#FF1E1E1E</Color>
        <Color x:Key="LightGrayColor">#FFCCCCCC</Color>

        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
        <SolidColorBrush x:Key="ContainerBgBrush" Color="{StaticResource ContainerBgColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentBlueColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
        <SolidColorBrush x:Key="TextMainBrush" Color="White" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAAAAA" />

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle"
                            SnapsToDevicePixels="True"
                            Background="#444444"
                            CornerRadius="4"
                            Margin="2,0,2,0"
                            Width="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true"
                                IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IconBorder" CornerRadius="4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background"
                                    Value="#3365ABFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="IconBorder" Property="Background"
                                    Value="{StaticResource DarkAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Root">
                            <Border x:Name="Border" Margin="0,0,10,0" Padding="10,5"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlueBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground"
                                    Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource WindowBgBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{TemplateBinding BorderBrush}"
                                CornerRadius="15,15,0,0" Padding="8,4">
                                <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold" />
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="0,0,15,15">
                                <ContentPresenter Margin="10" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}"
                            Padding="10,2">
                            <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF94D3FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#444444" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button"
            BasedOn="{StaticResource RoundedBlueButtonStyle}">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8B0000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedTextBoxLightStyle" 
       TargetType="TextBox" 
       BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
        </Style>
        <Style x:Key="RoundedYellowButtonStyle" TargetType="Button"
            BasedOn="{StaticResource RoundedBlueButtonStyle}">
            <Setter Property="Background" Value="#FF4D4D08" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFAEAE03" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF3F300" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                Grid.Column="2"
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="{StaticResource AccentBlueBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="8,5,25,5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                        Background="{StaticResource ContainerBgBrush}"
                                        BorderBrush="{StaticResource DarkAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DarkAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="RadioMark" Width="18" Height="18" Margin="2,0,8,0">
                                <Ellipse x:Name="OuterCircle"
                                    Stroke="{StaticResource DarkAccentBrush}"
                                    StrokeThickness="2"
                                    Fill="Transparent" />
                                <Ellipse x:Name="InnerCircle"
                                    Width="10"
                                    Height="10"
                                    Fill="{StaticResource AccentBlueBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888" />
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#444444" />
                                <Setter TargetName="InnerCircle" Property="Fill" Value="#444444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckMark"
                                Width="18"
                                Height="18"
                                Margin="2,0,8,0"
                                Background="Transparent"
                                BorderBrush="{StaticResource DarkAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="3">
                                <Path x:Name="CheckIcon"
                                    Data="M 0 4 L 3 7 L 8 0"
                                    Stroke="{StaticResource AccentBlueBrush}"
                                    StrokeThickness="2"
                                    Visibility="Collapsed"
                                    Margin="3" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckMark" Property="Background" Value="{StaticResource DarkAccentBrush}" />
                                <Setter TargetName="CheckMark" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckMark" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888" />
                                <Setter TargetName="CheckMark" Property="BorderBrush" Value="#444444" />
                                <Setter TargetName="CheckIcon" Property="Stroke" Value="#444444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkAccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3365ABFE" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="521*"/>
            <RowDefinition Height="48*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="161*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="TitleBar" Background="#1E1E1E" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="Title" Text="Profile editor" Foreground="White"
            Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="20,9,0,9" FontSize="16" FontWeight="Bold" />
        <Button x:Name="CloseXBTN" ToolTipService.InitialShowDelay="200" ToolTip="Close the tool"
            Content="X" Width="29" Height="24" HorizontalAlignment="Right"
            VerticalAlignment="Top" Margin="0,8,10,0" Grid.Column="1" Grid.Row="0"
            Style="{StaticResource CloseButtonStyle}" />
        <GroupBox Header="Keystroke and mouse actions" Margin="14,10,10,0" Grid.Column="1" Foreground="{StaticResource LightGrayBrush}"
            Style="{StaticResource CustomGroupBoxStyle}" Grid.Row="1">
            <Grid Margin="10,10,10,2">
                <Button x:Name="AddActionBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Add a new action"  Content="Add" Margin="0,0,250,9" HorizontalAlignment="Right" Width="75" Height="25" VerticalAlignment="Bottom"/>
                <Button x:Name="RemoveActionBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Remove the selected action"  Content="Remove" Margin="0,0,170,9" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75"/>
                <Button x:Name="MoveActionToEndBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Move action to end" Content="⏬" Margin="0,0,130,9" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="35"/>
                <Button x:Name="MoveActionDownBTN"  Style="{StaticResource RoundedBlueButtonStyle}"   ToolTipService.InitialShowDelay="200" ToolTip="Move action down" Content="🔽" Margin="0,0,90,9" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="35"/>
                <Button x:Name="MoveActionUpBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Move action up" Content="🔼" Margin="0,0,50,9" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="35"/>
                <Button x:Name="MoveActionToTopBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Move action to top" Content="⏫" Margin="0,0,10,9" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="35"/>
                <DataGrid Margin="0,0,0,45" x:Name="KeystrokesList"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow" BorderThickness="0">

                    <DataGrid.Columns>

                        <!-- 1. Action Column (ComboBox) -->
                        <DataGridTemplateColumn Header="Action" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Action}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Action, Mode=TwoWay}">
                                        <sys:String>Keys</sys:String>
                                        <sys:String>MouseClick</sys:String>
                                        <sys:String>MouseChangePositionX</sys:String>
                                        <sys:String>MouseChangePositionY</sys:String>
                                        <sys:String>MouseScroll</sys:String>
                                        <sys:String>MouseClickHold</sys:String>
                                        <sys:String>MouseClickRelease</sys:String>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Value Column (Text only) -->
                        <DataGridTextColumn Header="Value" Width="180*" Binding="{Binding Value, Mode=TwoWay}" />

                        <!-- 3. Delay Column (Text only) -->
                        <DataGridTextColumn Header="Delay (ms)" Width="100" Binding="{Binding Delay_ms, Mode=TwoWay}" />

                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="Help" Style="{StaticResource RoundedYellowButtonStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Open help documentation page"  Content="Help"  BorderThickness="0,0,0,0" Margin="10,0,0,9" HorizontalAlignment="Left" Width="75" Height="25" VerticalAlignment="Bottom"/>
            </Grid>

        </GroupBox>

        <Button x:Name="SaveBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Save the current profile"  Content="Save" Grid.Column="1" Margin="0,0,170,10" Grid.Row="2" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" IsEnabled="False"/>
        <Button x:Name="SaveAsBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Save the current profile as a new file"  Content="Save as" Grid.Column="1" Margin="0,0,90,10" Grid.Row="2" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75"/>
        <Button x:Name="CancelBTN"  Style="{StaticResource RoundedBlueButtonStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Cancel editing and close the profile editor"  Content="Cancel" Grid.Column="1" Margin="0,0,10,10" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" Height="25"/>
        <Grid Margin="0" Grid.RowSpan="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="63"/>
                <RowDefinition Height="21*"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="19*"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>
            
            <TextBox x:Name="FileNameEdit"  Style="{StaticResource RoundedTextBoxLightStyle}" VerticalScrollBarVisibility="Auto" Height="25" Margin="24,36,15,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="filename" IsEnabled="False"/>
            <Label Content="File Name" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="24,10,0,0" VerticalAlignment="Top" Height="26" Width="63"/>
            <TextBox x:Name="DescriptionEdit"  Style="{StaticResource RoundedTextBoxLightStyle}"  ToolTipService.InitialShowDelay="200" ToolTip="Profile description" Margin="24,26,15,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Grid.Row="1"/>
            <Label Content="Description" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Top" Height="26" Width="70" Grid.Row="1"/>
            <TextBox x:Name="ProcessNameEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Full or partial window process name. Wildcard character *" VerticalScrollBarVisibility="Auto" Height="25" Margin="24,26,15,0" TextWrapping="Wrap" VerticalAlignment="Top"  Grid.Row="2"/>
            <Label Content="DSP Software Process Name" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Top" Height="26" Width="159" Grid.Row="2" />

            <GroupBox Header="Decimals" Foreground="{StaticResource LightGrayBrush}"
            Style="{StaticResource CustomGroupBoxStyle}" Height="147" Margin="24,58,15,0" VerticalAlignment="Top" Grid.Row="2">
                <Grid Margin="10,0">
                    <TextBox x:Name="FreqDecimalsEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Number of decimal places for frequency values" HorizontalAlignment="Left" Height="25" Margin="0,26,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="70"/>
                    <Label Content="Freq" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox x:Name="QDecimalsEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Number of decimal places for Q values" HorizontalAlignment="Left" Height="25" Margin="75,26,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="70"/>
                    <Label Content="Q" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="75,0,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="GainDecimalsEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Number of decimal places for gain values" HorizontalAlignment="Left" Height="25" Margin="150,26,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="70"/>
                    <Label Content="Gain" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="145,0,0,0" VerticalAlignment="Top"/>
                    <Label Content="Decimal separator" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="0,54,0,0" VerticalAlignment="Top"/>
                    <RadioButton x:Name="DecimalSeparatorDot"  ToolTipService.InitialShowDelay="200" ToolTip="Use dot as decimal separator, example 1.5" Content="Dot &quot;.&quot;" HorizontalAlignment="Left" Margin="0,85,0,0" VerticalAlignment="Top" GroupName="DecimalSeparatorGroup" IsChecked="True"/>
                    <RadioButton x:Name="DecimalSeparatorComma"  ToolTipService.InitialShowDelay="200" ToolTip="Use comma as decimal separator, example 1,5" Content="Comma &quot;,&quot;" HorizontalAlignment="Left" Margin="0,105,0,0" VerticalAlignment="Top" GroupName="DecimalSeparatorGroup"/>
                    <Label Content="Q Divider" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="150,54,0,0" VerticalAlignment="Top" Height="26" Width="62"/>
                    <TextBox x:Name="QDividerEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Divider for Q values, example 2 means Q values will be divided by 2, or 0.5 means Q values will be multiplied by 2. Default is 1" HorizontalAlignment="Left" Height="25" Margin="150,80,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="70"/>
                </Grid>
            </GroupBox>
            <TextBox x:Name="StartingPositionEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Display message to help user understand starting position of the paste operation"  VerticalScrollBarVisibility="Auto" Margin="24,26,15,10" TextWrapping="Wrap" Grid.Row="3"/>
            <Label Content="Starting position hint"  Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Top" Height="26" Width="159" Grid.Row="3"/>

            <Label Content="Hotkey/delay" Foreground="{StaticResource LightGrayBrush}" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Top" Height="26" Width="94" Grid.Row="4"/>
            <RadioButton x:Name="HotkeySelected" ToolTipService.InitialShowDelay="200" ToolTip="Select to use a hotkey for the action"  Content="Hotkey" HorizontalAlignment="Left" Margin="24,26,0,0" VerticalAlignment="Top" GroupName="HotkeyOrDelayGroup" IsChecked="True" Height="15" Width="57" Grid.Row="4"/>
            <RadioButton x:Name="DelaySelected" ToolTipService.InitialShowDelay="200" ToolTip="Select to use a delay for the action" Content="Delay" HorizontalAlignment="Left" Margin="24,46,0,0" VerticalAlignment="Top" GroupName="HotkeyOrDelayGroup" Height="15" Width="49" Grid.Row="4"/>
            <Label x:Name="HotkeyLabel" Foreground="{StaticResource LightGrayBrush}" Content="Hotkey" HorizontalAlignment="Left" Margin="106,0,0,0" VerticalAlignment="Top" Height="26" Width="57" Grid.Row="4"/>
            <RadioButton x:Name="HotkeyDefault" ToolTipService.InitialShowDelay="200" ToolTip="Use the default hotkey for the action"  Content="Default" HorizontalAlignment="Left" Margin="106,26,0,0" VerticalAlignment="Top" GroupName="HotkeyGroup" IsChecked="True" Height="15" Width="57" Grid.Row="4"/>
            <RadioButton x:Name="HotkeyOverride" ToolTipService.InitialShowDelay="200" ToolTip="Override the default hotkey for the action" Content="Override" HorizontalAlignment="Left" Margin="106,46,0,0" VerticalAlignment="Top" GroupName="HotkeyGroup" Height="15" Width="77" Grid.Row="4"/>
            <Label x:Name="ActionLabel" Foreground="{StaticResource LightGrayBrush}" Content="Action" HorizontalAlignment="Left" Margin="185,0,0,0" VerticalAlignment="Top" Height="26" Width="57" Grid.Row="4" Visibility="Hidden"/>
            <Label x:Name="CancelLabel" Foreground="{StaticResource LightGrayBrush}" Content="Cancel" HorizontalAlignment="Left" Margin="242,0,0,0" VerticalAlignment="Top" Height="26" Width="57" Grid.Row="4" Visibility="Hidden"/>
            <ComboBox x:Name="ActionHotkeyCombo"
          SelectedIndex="10"
          IsEditable="False" Margin="185,0,0,39" Grid.Row="4" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="54" Visibility="Hidden">
                <ComboBoxItem>F1</ComboBoxItem>
                <ComboBoxItem>F2</ComboBoxItem>
                <ComboBoxItem>F3</ComboBoxItem>
                <ComboBoxItem>F4</ComboBoxItem>
                <ComboBoxItem>F5</ComboBoxItem>
                <ComboBoxItem>F6</ComboBoxItem>
                <ComboBoxItem>F7</ComboBoxItem>
                <ComboBoxItem>F8</ComboBoxItem>
                <ComboBoxItem>F9</ComboBoxItem>
                <ComboBoxItem>F10</ComboBoxItem>
                <ComboBoxItem>F11</ComboBoxItem>
                <ComboBoxItem>F12</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="CancelHotkeyCombo"
            SelectedIndex="11"
            IsEditable="False" Margin="244,0,0,39" Grid.Row="4" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="54" Visibility="Hidden">
                <ComboBoxItem Content="F1"/>
                <ComboBoxItem Content="F2"/>
                <ComboBoxItem Content="F3"/>
                <ComboBoxItem Content="F4"/>
                <ComboBoxItem Content="F5"/>
                <ComboBoxItem Content="F6"/>
                <ComboBoxItem Content="F7"/>
                <ComboBoxItem Content="F8"/>
                <ComboBoxItem Content="F9"/>
                <ComboBoxItem Content="F10"/>
                <ComboBoxItem Content="F11"/>
                <ComboBoxItem Content="F12"/>
            </ComboBox>
            <Label x:Name="DelayLabel" Foreground="{StaticResource LightGrayBrush}" Content="Delay, sec" HorizontalAlignment="Left" Margin="106,0,0,0" VerticalAlignment="Top" Height="26" Width="62" Grid.Row="4" Visibility="Hidden"/>
            <TextBox x:Name="DelayEdit" Style="{StaticResource RoundedTextBoxLightStyle}" ToolTipService.InitialShowDelay="200" ToolTip="Set the delay in seconds for the action" HorizontalAlignment="Left" Height="25" Margin="106,26,0,0" TextWrapping="Wrap" Text="6" VerticalAlignment="Top" Width="32" Grid.Row="4" Visibility="Hidden"/>
            <CheckBox x:Name="AdminRightsRequiredCHBX" ToolTipService.InitialShowDelay="200" ToolTip="Check if the DSP software requires administrative rights to run" Content="DSP software runs with admin rights" HorizontalAlignment="Left" Margin="24,66,0,0" VerticalAlignment="Top" Grid.Row="4" Height="15" Width="212"/>

        </Grid>
    </Grid>
</Window>