<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="REW EQ CopyPaste Assistant"
    Height="768"
    Width="1024"
    MinWidth="800"
    MinHeight="450"
    FontStretch="Expanded"
    FontStyle="Normal"
    FontWeight="Normal"
    Background="#FF292929"
    WindowStyle="None"
    ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
            GlassFrameThickness="0"
            CornerRadius="10" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="WindowBgColor">#FF292929</Color>
        <Color x:Key="ContainerBgColor">#FF35353A</Color>
        <Color x:Key="AccentBlueColor">#FF65ABFE</Color>
        <Color x:Key="DarkAccentBlueColor">#FF367ACB</Color>
        <Color x:Key="SurfaceColor">#FF1E1E1E</Color>
        <Color x:Key="LightGrayColor">#FFCCCCCC</Color>

        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
        <SolidColorBrush x:Key="ContainerBgBrush" Color="{StaticResource ContainerBgColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentBlueColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
        <SolidColorBrush x:Key="TextMainBrush" Color="White" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAAAAA" />

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle"
                            SnapsToDevicePixels="True"
                            Background="#444444"
                            CornerRadius="4"
                            Margin="2,0,2,0"
                            Width="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true"
                                IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IconBorder" CornerRadius="4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background"
                                    Value="#3365ABFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="IconBorder" Property="Background"
                                    Value="{StaticResource DarkAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Root">
                            <Border x:Name="Border" Margin="0,0,10,0" Padding="10,5"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlueBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground"
                                    Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource WindowBgBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ContainerBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{TemplateBinding BorderBrush}"
                                CornerRadius="15,15,0,0" Padding="8,4">
                                <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold" />
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="0,0,15,15">
                                <ContentPresenter Margin="10" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}"
                            Padding="10,2">
                            <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF94D3FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#444444" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button"
            BasedOn="{StaticResource RoundedBlueButtonStyle}">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8B0000" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundedYellowButtonStyle" TargetType="Button"
            BasedOn="{StaticResource RoundedBlueButtonStyle}">
            <Setter Property="Background" Value="#FF4D4D08" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFAEAE03" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF3F300" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid TextBlock.FontWeight="Normal">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="37" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="119*" />
            <ColumnDefinition Width="145*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="TitleBar" Background="#1E1E1E" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="Title" Text="REW EQ CopyPaste Assistant" Foreground="White"
            Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="20,9,0,9" FontSize="16" FontWeight="Bold" />
        <Button x:Name="CloseXBTN" ToolTipService.InitialShowDelay="200" ToolTip="Close the tool"
            Content="X" Width="29" Height="24" HorizontalAlignment="Right"
            VerticalAlignment="Top" Margin="0,8,10,0" Grid.Column="1" Grid.Row="0"
            Style="{StaticResource CloseButtonStyle}" />
        <GroupBox Header="DSP profile list" Margin="10,10,0,10" Grid.Column="0" Grid.Row="1"
            Foreground="{StaticResource LightGrayBrush}"
            Style="{StaticResource CustomGroupBoxStyle}">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="27" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" MinWidth="26" />
                    </Grid.ColumnDefinitions>

                    <Label x:Name="SearchLabel"
                        Content="🔎︎"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="0,-1,0,0" Height="26" HorizontalAlignment="Left" Foreground="White" />

                    <TextBox x:Name="SearchEDIT"
                        Margin="0,0,5,0"
                        ToolTip="Search filter" ToolTipService.InitialShowDelay="200"
                        VerticalAlignment="Center" Height="25" Grid.Column="1"
                        Style="{StaticResource RoundedTextBoxStyle}" />

                    <Button x:Name="ClearSearchBTN"
                        Content="❎"
                        Grid.Column="2"
                        Height="25"
                        Margin="2,1,2,0"
                        ToolTip="Clear search filter and refresh list"
                        ToolTipService.InitialShowDelay="200" VerticalAlignment="Top"
                        Style="{StaticResource RoundedBlueButtonStyle}" />
                </Grid>
                <ListBox x:Name="ProfileList"
                    Grid.Row="2"
                    VerticalAlignment="Stretch" Margin="0,10,0,0" />

            </Grid>
        </GroupBox>

        <GroupBox Header="Profile settings" Margin="10,10,10,10" Grid.Column="1" Grid.Row="1"
            Foreground="{StaticResource LightGrayBrush}"
            Style="{StaticResource CustomGroupBoxStyle}">
            <TabControl Margin="0" Background="{StaticResource ContainerBgBrush}"
                BorderThickness="0">
                <TabItem Header="Overview">
                    <TextBlock x:Name="ProfileOverview" TextWrapping="Wrap"
                        Foreground="{StaticResource LightGrayBrush}"
                        Background="{StaticResource ContainerBgBrush}"
                        Text="Please select a profile" Margin="5" />
                </TabItem>
                <TabItem Header="Profile details">
                    <TextBox x:Name="ProfileText" TextWrapping="Wrap" Text="Please select a profile"
                        Foreground="{StaticResource LightGrayBrush}"
                        Background="{StaticResource ContainerBgBrush}"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Margin="5" BorderThickness="0" />
                </TabItem>
            </TabControl>
        </GroupBox>

        <Button x:Name="OKBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Start with selected profile" Content="OK" Width="80" IsEnabled="False"
            IsDefault="True" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,280,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="NewProfileBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Create a new profile" Content="New Profile" Width="80" Height="25"
            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,190,10"
            Grid.Column="1" Grid.Row="2" Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="EditBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Edit or save a copy of selected profile" Content="Edit" Width="80"
            IsEnabled="False" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,100,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="CloseBTN" ToolTipService.InitialShowDelay="200" ToolTip="Close the tool"
            Content="Close" Width="80" Height="25" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Label x:Name="HotkeyHint" Content="Hotkey or Delay preference depends on profile settings"
            HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Height="26"
            Width="312" Grid.Row="2" Grid.ColumnSpan="2"
            Foreground="{StaticResource LightGrayBrush}" />
        <Button x:Name="GitHub" ToolTipService.InitialShowDelay="200"
            ToolTip="Open GitHub project page in web browser" Width="112" Height="24"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,140,0"
            Style="{StaticResource RoundedYellowButtonStyle}" Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Project page" VerticalAlignment="Top" Margin="0,2,0,0" />
                <Image x:Name="GitHubIcon" Source="Images/my_icon.png" Width="20" Height="20"
                    Margin="5,0,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="Donate" ToolTipService.InitialShowDelay="200" Margin="0,8,50,0"
            ToolTip="Support the project (PayPal)" Grid.Column="1" Grid.Row="0"
            HorizontalAlignment="Right" Width="84" Height="24" VerticalAlignment="Top"
            Style="{StaticResource RoundedYellowButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Donate" VerticalAlignment="Center" />
                <Image x:Name="DonateIcon" Source="Images/my_icon.png" Width="20" Height="20"
                    Margin="5,0,0,0" />
            </StackPanel>
        </Button>
        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2" BorderThickness="0"
            Background="#FF35353A">
            <StatusBarItem BorderThickness="0">
                <TextBlock Text="DSP:" FontFamily="Segoe UI Symbol"
                    Foreground="{StaticResource LightGrayBrush}" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="ProcessStatus" Text="⬤"
                    Width="15" MinWidth="15" Foreground="Gray" ToolTip="DSP Software Status" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0">
                <TextBlock Text="REW:" FontFamily="Segoe UI Symbol"
                    Foreground="{StaticResource LightGrayBrush}" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="REWStatus" Text="⬤"
                    Width="15" MinWidth="15" Foreground="Gray" ToolTip="REW Status" />
            </StatusBarItem>
            <Button x:Name="RunREWBTN" ToolTipService.InitialShowDelay="200"
                ToolTip="Start REW" Content="▶️" Width="28"
                Visibility="Hidden"
                Style="{StaticResource RoundedBlueButtonStyle}" FontSize="10"
            />
            <StatusBarItem BorderThickness="0">
                <TextBlock x:Name="Hint" Text="Hint: Select a profile to begin"
                    Foreground="{StaticResource LightGrayBrush}" Visibility="Hidden" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0" HorizontalAlignment="Right">
                <TextBlock x:Name="Version" Text="Version: "
                    Foreground="{StaticResource LightGrayBrush}" Margin="0,0,5,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>