<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="REW EQ CopyPaste Assistant"
    Height="602"
    Width="800"
    MinWidth="800"
    MinHeight="450"
    FontStretch="Expanded"
    FontStyle="Normal"
    FontWeight="Normal"
    Background="#FF140C47"
    WindowStyle="None"
    ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF3A2D8C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IconBorder" CornerRadius="4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#3365ABFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#FF367ACB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Root">
                            <Border x:Name="Border" Margin="0,0,10,0" Padding="10,5" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF65ABFE" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF65ABFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                            <!--<Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#FF65ABFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0,5,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF4CCEFF" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                <Setter Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="#FF180D61" />
            <Setter Property="BorderBrush" Value="#FF180D61" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="15,15,0,0"
                                Padding="8,4">
                                <ContentPresenter ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    TextBlock.FontWeight="Bold" />
                            </Border>

                            <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,15,15">
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="RoundedBlueButtonStyle" TargetType="Button">
           <!--#endregion <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis" /> -->
            <Setter Property="Background" Value="#FF367ACB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="80" Height="25"
                            CornerRadius="12"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF65ABFE" />
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555588" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid TextBlock.FontWeight="Normal">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="37" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="159*" />
            <ColumnDefinition Width="238*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#1E1E1E" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="Title" Text="REW EQ CopyPaste Assistant" Foreground="White" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="16"/>
        <GroupBox Header="DSP profile list" Margin="10,10,0,10" Grid.Column="0" Grid.Row="1"
            Foreground="#FF65ABFE" Style="{StaticResource CustomGroupBoxStyle}">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="27" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" MinWidth="26" />
                    </Grid.ColumnDefinitions>

                    <Label x:Name="SearchLabel"
                        Content="🔎︎"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="0,-1,0,0" Height="26" HorizontalAlignment="Left" Foreground="White" />

                    <TextBox x:Name="SearchEDIT"
                        Margin="0"
                        ToolTip="Search filter" ToolTipService.InitialShowDelay="200"
                        VerticalAlignment="Center" Height="20" Grid.Column="1"
                        Style="{StaticResource RoundedTextBoxStyle}" />

                    <Button x:Name="ClearSearchBTN"
                        Content="❎"
                        Grid.Column="2"
                        Height="25"
                        Margin="2,1,2,0"
                        ToolTip="Clear search filter and refresh list"
                        ToolTipService.InitialShowDelay="200" VerticalAlignment="Top"
                        Style="{StaticResource RoundedBlueButtonStyle}" />
                </Grid>
                <ListBox x:Name="ProfileList"
                    Grid.Row="2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VerticalAlignment="Stretch" />

            </Grid>
        </GroupBox>

        <GroupBox Header="Profile settings" Margin="10,10,10,10" Grid.Column="1" Grid.Row="1"
            Foreground="#FF65ABFE" Style="{StaticResource CustomGroupBoxStyle}">
            <TabControl Margin="0">
                <TabItem Header="Overview">
                    <TextBlock x:Name="ProfileOverview" TextWrapping="Wrap"
                        Text="Please select a profile" Margin="5" />
                </TabItem>
                <TabItem Header="Profile details">
                    <TextBox x:Name="ProfileText" TextWrapping="Wrap" Text="Please select a profile"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Margin="0" Background="{x:Null}" />
                </TabItem>
            </TabControl>
        </GroupBox>

        <Button x:Name="OKBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Start with selected profile" Content="OK" Width="80" IsEnabled="False"
            IsDefault="True" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,280,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="NewProfileBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Create a new profile" Content="New Profile" Width="80" Height="25"
            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,190,10"
            Grid.Column="1" Grid.Row="2" Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="EditBTN" ToolTipService.InitialShowDelay="200"
            ToolTip="Edit or save a copy of selected profile" Content="Edit" Width="80"
            IsEnabled="False" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,100,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Button x:Name="CloseBTN" ToolTipService.InitialShowDelay="200" ToolTip="Close the tool"
            Content="Close" Width="80" Height="25" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RoundedBlueButtonStyle}" />
        <Label x:Name="HotkeyHint" Content="Hotkey or Delay preference depends on profile settings"
            HorizontalAlignment="Left" Margin="115,0,0,10" VerticalAlignment="Bottom" Height="26"
            Width="312" Grid.Row="2" Grid.ColumnSpan="2" Foreground="White" />
        <Button x:Name="GitHub" ToolTipService.InitialShowDelay="200"
            ToolTip="Open GitHub project page in web browser" Width="100" Height="25"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
            Foreground="#FF001BFB" BorderBrush="{x:Null}" Background="{x:Null}"
            BorderThickness="0,0,0,0" Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="GitHubIcon" Source="Images/my_icon.png" Width="24" Height="22"
                    Margin="0,0,5,0" />
                <TextBlock Text="Project page" VerticalAlignment="Top" Margin="0,2,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="Donate" ToolTipService.InitialShowDelay="200" Margin="0,12,10,0"
            Foreground="#FF001BFB" BorderBrush="{x:Null}" Background="{x:Null}"
            BorderThickness="0,0,0,0" ToolTip="Support the project (PayPal)" Grid.Column="1"
            Grid.Row="1" HorizontalAlignment="Right" Width="70" Height="25" VerticalAlignment="Top"
            Style="{StaticResource RoundedBlueButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Donate" VerticalAlignment="Center" />
                <Image x:Name="DonateIcon" Source="Images/my_icon.png" Width="24" Height="20"
                    Margin="5,0,0,0" />
            </StackPanel>
        </Button>
        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0"
            Background="#FF140C47">
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8">
                <TextBlock Text="DSP:" FontFamily="Segoe UI Symbol" Foreground="White" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="ProcessStatus" Text="⬤"
                    Width="15" MinWidth="15" Foreground="Gray" ToolTip="DSP Software Status" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8">
                <TextBlock Text="REW:" FontFamily="Segoe UI Symbol" Foreground="White" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8">
                <TextBlock ToolTipService.InitialShowDelay="200" x:Name="REWStatus" Text="⬤"
                    Width="15" MinWidth="15" Foreground="Gray" ToolTip="REW Status" />
            </StatusBarItem>
            <Button x:Name="RunREWBTN" ToolTipService.InitialShowDelay="200"
                ToolTip="Start REW in API mode" Content="▶️" Width="22" Background="{x:Null}"
                Padding="0" BorderThickness="0" BorderBrush="{x:Null}" Foreground="orange"
                Visibility="Hidden" />
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8">
                <TextBlock x:Name="Hint" Text="Hint: Select a profile to begin" Foreground="White" />
            </StatusBarItem>
            <StatusBarItem BorderThickness="0" BorderBrush="#FFA8A8A8" HorizontalAlignment="Right">
                <TextBlock x:Name="Version" Text="Version: " Foreground="White" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>