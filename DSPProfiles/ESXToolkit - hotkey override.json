{
    "version": "1.0",
	"Description": "ESX Toolkit DSP software",
    "processName": "ESX_Toolkit_*",
    "QDevider": 11,
    "QDecimals": 11,
    "GainDecimals": 11,
"FreqDecimals": 44,
    "DecimalSeparator": ",",
    "TimeoutBeforePasteSecs": 3,
    "StartingPositionHint": "Please select 1 band Freq box",
    "HotkeyOrDelayPreference": "Delay",
      "ProfilePerformActionHotkey": "F5",
    "ProfileCancelActionHotkey": "F6",  
    "KeystrokeSequence": [
        {
            "keys": "^aFREQ{ENTER}{DOWN}QVALUE{ENTER}{DOWN}GAIN{ENTER}",
            "delay_ms": 200
        },
        {
            "keys": "{RIGHT}{UP}{UP}",
            "delay_ms": 200
        }
    ]
}