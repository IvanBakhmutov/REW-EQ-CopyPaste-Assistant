{
    "version": "1.0",
	"Description": "MS Excel",
    "processName": "excel*",
    "QDevider": 3,
    "QDecimals": 10,
    "GainDecimals": 1,
    "DecimalSeparator": ".",
    "TimeoutBeforePasteSecs": 6,
    "StartingPositionHint": "Please select 1 cell",
    "HotkeyOrDelayPreference": "Hotkey",
    "ProfilePerformActionHotkey": "F5",
    "ProfileCancelActionHotkey": "F6",
    "KeystrokeSequence": [
        {
            "mouseClick": "left",
            "delay_ms": 50
        },
        {
            "keys": "^aFREQ",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "+25",
            "delay_ms": 10
        },
        {
            "mouseClick": "left",
            "delay_ms": 50
        },        
        {
            "keys": "^aQVALUE",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "+25",
            "delay_ms": 10
        },
        {
            "mouseClick": "left",
            "delay_ms": 50
        },        
        {
            "keys": "^aGAIN",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "-50",
            "delay_ms": 10
        },
        {
            "mouseChangePositionX": "+66",
            "delay_ms": 10
        }
    ]
}