{
    "version": "1.0",
	"Description": "MUSWAY (no 512K) DSP software",
    "processName": "Musway*",
    "QDevider": 1,
    "QDecimals": 2,
    "GainDecimals": 1,
    "DecimalSeparator": ".",
    "TimeoutBeforePasteSecs": 6,
    "StartingPositionHint": "Please hover mouse over 1 band Freq box and wait",
    "KeystrokeSequence": [
        {
            "mouseClick": "left",
            "delay_ms": 50
        },
        {
            "keys": "^aFREQ",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "+22",
            "delay_ms": 10
        },
        {
            "mouseClick": "left",
            "delay_ms": 50
        },
        {
            "keys": "^aQVALUE",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "+22",
            "delay_ms": 10
        },
        {
            "mouseClick": "left",
            "delay_ms": 50
        },
        {
            "keys": "^aGAIN{ENTER}",
            "delay_ms": 200
        },
        {
            "mouseChangePositionY": "-44",
            "delay_ms": 10
        },
        {
            "mouseChangePositionX": "+34",
            "delay_ms": 10
        }
    ]
}